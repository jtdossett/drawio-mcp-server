<mxfile host="app.diagrams.net">
  <diagram name="First" id="p1">
    <mxGraphModel dx="800" dy="600" grid="0" page="1">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="x" value="One" style="rounded=0;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="80" height="40" as="geometry"/></mxCell>
      </root></mxGraphModel>
  </diagram>
  <diagram name="Second" id="p2">
    <mxGraphModel dx="800" dy="600" grid="0" page="1">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="y" value="Two" style="shape=mxgraph.nonsense.widget;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="80" height="40" as="geometry"/></mxCell>
      </root></mxGraphModel>
  </diagram>
</mxfile>
